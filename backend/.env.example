# Fireworks.ai — OpenAI-compatible API (https://api.fireworks.ai/inference/v1)
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Single-model setup (recommended with limited credits — ~$5 left)
# Used for extraction (C3-03) and query (C3-05)
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_MODEL_EXTRACTION=accounts/fireworks/models/llama-v3p1-70b-instruct
FIREWORKS_MODEL_QUERY=accounts/fireworks/models/llama-v3p1-70b-instruct

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=memoryweave
CHROMA_HOST=localhost
CHROMA_PORT=8001
