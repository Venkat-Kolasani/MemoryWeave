# Fireworks.ai — OpenAI-compatible API (https://api.fireworks.ai/inference/v1)
# Paste the FULL key from https://fireworks.ai/account/api-keys (typically 40+ chars).
# A short placeholder will cause 404 "Model not found" on every model.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Single-model setup (recommended with limited credits — ~$5 left)
# Used for extraction (C3-03) and query (C3-05)
# Use a model from GET https://api.fireworks.ai/inference/v1/models (Bearer FIREWORKS_API_KEY)
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p5
FIREWORKS_MODEL_EXTRACTION=accounts/fireworks/models/kimi-k2p5
FIREWORKS_MODEL_QUERY=accounts/fireworks/models/kimi-k2p5

NEO4J_URI=bolt://localhost:7687
# Coral HTTP API (convert neo4j+s:// or bolt:// to https:// or http://)
# NEO4J_URL=https://<instance-id>.databases.neo4j.io
# Local Docker: neo4j | Aura download file: NEO4J_USERNAME=7459e09d (use either name)
NEO4J_USER=neo4j
# NEO4J_USERNAME=7459e09d
NEO4J_PASSWORD=memoryweave
# NEO4J_DATABASE=neo4j

# Chroma: http = local `chroma run` (default); inmemory = Render production
CHROMA_MODE=http
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Set false on Render free tier (512MB) — startup embedding model download causes OOM
CHROMA_STARTUP_POPULATE=true

# Optional: comma-separated origins (default *). Example after Vercel deploy:
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
